{
  "name": "@dtp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/app.test.ts",
    "test:db": "tsx scripts/verify-database.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "test:auth": "tsx scripts/test-auth.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.3.1",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
