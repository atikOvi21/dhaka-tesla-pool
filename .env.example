# LOCAL DEMO ONLY. Copy to .env. Never use these credentials for public deployment.
POSTGRES_USER=dtp
POSTGRES_PASSWORD=dtp_demo_only
POSTGRES_DB=dhaka_tesla_pool
# Host-run API uses compose.dev.yaml's loopback database port.
DATABASE_URL=postgresql://dtp:dtp_demo_only@127.0.0.1:5433/dhaka_tesla_pool
PORT=3000
WEB_PORT=8080
NODE_ENV=development
# Local seed only. Disable for environments with real users.
SEED_DEMO=true

# Generate a random secret before starting the API; see README. This placeholder is rejected.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Defaults support both host Vite and Compose HTTP localhost; use HTTPS-only origins for deployment.
AUTH_ORIGINS=http://localhost:5173,http://localhost:8080
SESSION_COOKIE_SECURE=false
# Host-run API trusts no proxy. Compose explicitly uses one internal Nginx hop.
TRUST_PROXY_HOPS=0
# Disposable PostgreSQL database from compose.auth-test.yaml (never development data).
AUTH_TEST_DATABASE_URL=postgresql://dtp_test:dtp_test_only@127.0.0.1:5434/dhaka_tesla_auth_test